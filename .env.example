# --- LLM / 搜索（必填）---
OPENAI_API_KEY=
TAVILY_API_KEY=
# 带图对话生成（graph generate_answer）：多模态模型，默认 gpt-4o
# VISION_LLM_MODEL=gpt-4o

# --- LangSmith（可选，用于 LangGraph / LangChain Trace）---
# 控制台: https://smith.langchain.com/  → Settings → API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# 同一工作区下的项目名，便于筛选
LANGSMITH_PROJECT=food-ai-agent

# --- 生产部署（docker-compose.prod + Caddy）---
# 域名（无协议），与 DNS A 记录一致
# PUBLIC_DOMAIN=app.example.com
# 浏览器访问的站点源（须 https，与 Caddy 对外一致；前端 build 用此值）
# PUBLIC_API_URL=https://app.example.com
# Let's Encrypt 邮箱
# ACME_EMAIL=you@example.com
# CORS：与前端 Origin 一致，多个逗号分隔
# CORS_ALLOW_ORIGINS=https://app.example.com
# Uvicorn worker 数（可选）
# UVICORN_WORKERS=2

# --- PostgreSQL（结构化数据；graph / SQL Agent / 图片分析产品库）---
# 本机开发默认见 db.get_database_url()
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/food_ai
# docker-compose.prod 内 api 默认（主机名为 compose 服务名 postgres）：
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/food_ai
# 若改库口令或库名，同步设置：
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=food_ai
# ENABLE_PG_CONVERSATION_CHECKPOINT=true

# --- 其它（按需复制 README 中说明）---
# REDIS_URL=redis://localhost:6379/0
# REDIS_URL=redis://redis:6379/0
